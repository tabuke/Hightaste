<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HIGHTASTE | Farm Management System</title>

<style>
:root {
  --green: #176b43;
  --dark: #10452e;
  --light: #eaf5ee;
  --gold: #d4af37;
  --bg: #f4f7f5;
  --white: #ffffff;
  --text: #202b25;
  --border: #dfe7e1;
  --red: #d93025;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Arial, sans-serif;
  background: var(--bg);
  color: var(--text);
}

header {
  background: var(--dark);
  color: white;
  padding: 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 15px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.logo {
  background: var(--gold);
  color: var(--dark);
  padding: 12px;
  font-weight: bold;
  border-radius: 10px;
  font-size: 20px;
}

header h1 {
  font-size: 22px;
}

header p {
  font-size: 12px;
  margin-top: 5px;
  color: #d9e8dd;
}

#dateTime {
  font-size: 13px;
}

nav {
  background: white;
  padding: 10px;
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  border-bottom: 1px solid var(--border);
}

nav button {
  border: none;
  background: transparent;
  padding: 12px;
  cursor: pointer;
  border-radius: 7px;
  font-weight: bold;
  color: var(--text);
}

nav button.active,
nav button:hover {
  background: var(--green);
  color: white;
}

main {
  padding: 22px;
  max-width: 1500px;
  margin: auto;
}

.page {
  display: none;
}

.page.active {
  display: block;
}

.page-title {
  margin-bottom: 20px;
}

.page-title h2 {
  font-size: 25px;
  color: var(--dark);
  margin-bottom: 8px;
}

.page-title p {
  color: #68766d;
  line-height: 1.6;
}

.cards {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 15px;
  margin-bottom: 25px;
}

.card {
  background: white;
  padding: 22px;
  border-radius: 12px;
  border: 1px solid var(--border);
  box-shadow: 0 3px 10px #00000005;
}

.card small {
  color: #65746a;
  display: block;
  margin-bottom: 12px;
}

.card h3 {
  font-size: 28px;
  color: var(--green);
  overflow-wrap: anywhere;
}

.panel {
  background: white;
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 22px;
  margin-bottom: 22px;
}

.panel h3 {
  margin-bottom: 18px;
  color: var(--dark);
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.field label {
  font-size: 13px;
  font-weight: bold;
}

input, select, textarea {
  width: 100%;
  padding: 12px;
  border: 1px solid #ccd8cf;
  border-radius: 7px;
  font-size: 14px;
  background: white;
  color: var(--text);
}

input:focus, select:focus, textarea:focus {
  outline: 2px solid #176b4330;
  border-color: var(--green);
}

textarea {
  min-height: 90px;
  resize: vertical;
}

.full {
  grid-column: 1 / -1;
}

button.primary,
button.secondary,
button.danger {
  border: none;
  padding: 12px 17px;
  border-radius: 7px;
  cursor: pointer;
  font-weight: bold;
}

button.primary {
  background: var(--green);
  color: white;
}

button.secondary {
  background: var(--light);
  color: var(--dark);
}

button.danger {
  background: #fdecea;
  color: var(--red);
}

button:hover {
  opacity: .88;
}

.form-actions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-top: 20px;
}

.table-wrap {
  overflow-x: auto;
  width: 100%;
}

table {
  width: 100%;
  border-collapse: collapse;
  min-width: 650px;
}

th, td {
  text-align: left;
  padding: 13px 12px;
  border-bottom: 1px solid var(--border);
  font-size: 13px;
}

th {
  background: #f1f7f2;
  color: var(--dark);
}

tr:hover td {
  background: #fafcfb;
}

.toolbar {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 18px;
}

.toolbar input {
  max-width: 350px;
}

.badge {
  display: inline-block;
  padding: 5px 9px;
  border-radius: 20px;
  background: var(--light);
  color: var(--dark);
  font-size: 11px;
  font-weight: bold;
}

.photo-preview {
  width
